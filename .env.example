# Salin berkas ini jadi .env.local, lalu isi dengan nilai asli.
# Jangan pernah commit .env.local.

# Supabase, dipakai fitur Lapor Warga
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Panel petugas di /admin
ADMIN_PASSWORD=
# String acak panjang untuk menandatangani cookie sesi admin.
# Buat dengan: openssl rand -base64 32
ADMIN_SESSION_SECRET=
